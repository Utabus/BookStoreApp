<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutReaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    tools:context=".BookReaderActivity"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Top Action Header -->
    <LinearLayout
        android:id="@+id/layoutReaderHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnReaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReaderBookTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên sách"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReaderAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bản đọc thử miễn phí"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChapterBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_unselected"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Chương 1"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reading Content Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReaderContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvReaderChapterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="CHƯƠNG 1: KHỞI ĐẦU HÀNH TRÌNH"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <View
                android:id="@+id/dividerReader"
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@color/primary" />

            <TextView
                android:id="@+id/tvReaderBookContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"
                android:text="Nội dung trích đoạn sách..."
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Bạn vừa đọc xong phần trích đoạn mẫu"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Đặt mua sách ngay hôm nay để thưởng thức trọn vẹn toàn bộ tác phẩm hấp dẫn này!"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReaderBuyBook"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="MUA SÁCH NGAY"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Reading Controls Toolbar -->
    <LinearLayout
        android:id="@+id/layoutReaderToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Font Size Decrease -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontDecrease"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="A-"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeColor="@color/border_subtle" />

        <TextView
            android:id="@+id/tvCurrentFontSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="16"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <!-- Font Size Increase -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontIncrease"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="A+"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeColor="@color/border_subtle" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Theme Color Buttons -->
        <!-- Light Theme -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeLight"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="18dp"
            app:strokeColor="#CCCCCC"
            app:strokeWidth="2dp" />

        <!-- Sepia Paper Theme -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeSepia"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="#F8EED9"
            app:cornerRadius="18dp"
            app:strokeColor="#C5B18D"
            app:strokeWidth="1dp" />

        <!-- Dark Reading Theme -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeDark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="#1F2328"
            app:cornerRadius="18dp"
            app:strokeColor="#444C56"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>
