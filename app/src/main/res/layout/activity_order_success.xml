<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".OrderSuccessActivity"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Big Success Badge -->
    <androidx.cardview.widget.CardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardBackgroundColor="@color/status_success_bg"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:tint="@color/status_success" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Đặt hàng thành công!"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_2xl"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSuccessOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mã đơn hàng: #ORD-1001"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_md"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đơn hàng của bạn đã được tiếp nhận và đang được xử lý để gửi đi trong thời gian sớm nhất."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_md" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewOrders"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_button_primary"
        android:text="XEM ĐƠN HÀNG CỦA TÔI"
        android:textColor="@color/white"
        android:textSize="@dimen/text_md"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="@dimen/radius_md" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueShopping"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="12dp"
        android:text="TIẾP TỤC MUA SẮM"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_md"
        android:textStyle="bold"
        app:cornerRadius="@dimen/radius_md"
        app:strokeColor="@color/primary" />

</LinearLayout>
