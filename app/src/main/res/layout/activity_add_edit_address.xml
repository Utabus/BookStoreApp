<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".AddEditAddressActivity"
    tools:ignore="HardcodedText,ContentDescription,Autofill">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/layoutAddEditHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvAddEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Thêm địa chỉ mới"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layoutSaveBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAddEditHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card for inputs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Thông tin người nhận"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_md"
                        android:textStyle="bold" />

                    <!-- Recipient Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRecipientName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Họ và tên người nhận"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/radius_md"
                        app:boxCornerRadiusTopStart="@dimen/radius_md"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRecipientName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_md" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRecipientPhone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Số điện thoại"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/radius_md"
                        app:boxCornerRadiusTopStart="@dimen/radius_md"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRecipientPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_md" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Detail Street Address -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStreetAddress"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Địa chỉ cụ thể (Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành)"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/radius_md"
                        app:boxCornerRadiusTopStart="@dimen/radius_md"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtStreetAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:lines="3"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_md" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Address Type / Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Loại địa chỉ"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgAddressLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Nhà riêng"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rbOffice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="Văn phòng"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rbOther"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="Khác"
                            android:textColor="@color/text_primary" />
                    </RadioGroup>

                    <!-- Switch Default -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDefaultAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Đặt làm địa chỉ mặc định"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_md" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Save Button Container -->
    <LinearLayout
        android:id="@+id/layoutSaveBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:text="LƯU ĐỊA CHỈ"
            android:textColor="@color/white"
            android:textSize="@dimen/text_md"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_md" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
